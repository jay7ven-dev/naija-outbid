# Neon Postgres — https://console.neon.tech → project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Paystack test keys — https://dashboard.paystack.com/#/settings/developer
# Use TEST keys for local/dev. Secret must never be NEXT_PUBLIC_*.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App URL (no trailing slash). Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin gate — set a strong password; used for /admin cookie auth
ADMIN_PASSWORD=change-me
